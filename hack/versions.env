GO_LINUX_ARM64_SHA256=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49
TASK_VERSION=3.54.0
BAZELISK_VERSION=1.30.0
BAZEL_VERSION=9.3.2
RULES_GO_VERSION=0.65.0
GAZELLE_VERSION=0.54.0
RULES_CC_VERSION=0.2.27
GOLANGCI_LINT_VERSION=2.15.0
GOFUMPT_VERSION=0.12.0
GOIMPORTS_VERSION=0.52.0
GOCOVER_COBERTURA_VERSION=1.5.0
