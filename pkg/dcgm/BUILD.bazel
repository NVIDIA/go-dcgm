cc_library(
    name = "dcgm_headers",
    hdrs = [
        "dcgm_agent.h",
        "dcgm_api_export.h",
        "dcgm_errors.h",
        "dcgm_fields.h",
        "dcgm_nvml.h",
        "dcgm_structs.h",
        "dcgm_structs_internal.h",
        "dcgm_test_apis.h",
        "dcgm_test_structs.h",
        "field_values_cb.h",
        "nvml.h",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "link_dcgm_runtime",
    define_values = {"link_dcgm_runtime": "true"},
)

# keep: preserve this hand-written cgo target during Gazelle updates.
go_library(
    name = "dcgm",
    srcs = [
        "admin.go",
        "api.go",
        "callback.c",
        "const.go",
        "const_fields.go",
        "cpu.go",
        "dcgm_agent.h",
        "dcgm_api_export.h",
        "dcgm_errors.h",
        "dcgm_fields.h",
        "dcgm_nvml.h",
        "dcgm_structs.h",
        "dcgm_structs_internal.h",
        "dcgm_test_apis.h",
        "dcgm_test_structs.h",
        "device_info.go",
        "device_status.go",
        "diag.go",
        "error.go",
        "field_policy.go",
        "field_policy_callback.c",
        "field_scope.go",
        "field_summary.go",
        "field_values.go",
        "field_values_bench_helpers.go",
        "field_values_cb.c",
        "field_values_cb.h",
        "fields.go",
        "gpu_group.go",
        "health.go",
        "hostengine_status.go",
        "internal.go",
        "mig.go",
        "mndiag.go",
        "nvml.h",
        "policy.go",
        "process_info.go",
        "profile.go",
        "structs.go",
        "topology.go",
        "utils.go",
        "version_info.go",
    ],
    cgo = True,
    clinkopts = select({
        "@rules_go//go/platform:android": [
            "-ldl -Wl,--export-dynamic -Wl,--unresolved-symbols=ignore-in-object-files",
        ],
        "@rules_go//go/platform:darwin": [
            "-ldl -Wl,--export-dynamic -Wl,-undefined,dynamic_lookup",
            "-ldl -Wl,-undefined,dynamic_lookup",
        ],
        "@rules_go//go/platform:ios": [
            "-ldl -Wl,--export-dynamic -Wl,-undefined,dynamic_lookup",
            "-ldl -Wl,-undefined,dynamic_lookup",
        ],
        "@rules_go//go/platform:linux": [
            "-ldl -Wl,--export-dynamic -Wl,--unresolved-symbols=ignore-in-object-files",
        ],
        "//conditions:default": [],
    }) + select({
        ":link_dcgm_runtime": ["-Wl,--no-as-needed -ldcgm -Wl,--as-needed"],
        "//conditions:default": [],
    }),
    importpath = "github.com/NVIDIA/go-dcgm/pkg/dcgm",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_bits_and_blooms_bitset//:bitset",
    ],
)

