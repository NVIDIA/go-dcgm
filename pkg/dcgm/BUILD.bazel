load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:exclude alias_resolution_test.go
# gazelle:exclude base_unit_fields_test.go
# gazelle:exclude const_test.go
# gazelle:exclude cpu_test_helpers.go
