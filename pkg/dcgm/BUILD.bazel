        "bind_unbind_test.go",
        "cpu_test.go",
        "cpu_test_helpers.go",  # keep: used by the runtime test target.
        "diag_test.go",
        "diag_test_helpers.go",  # keep: used by the runtime test target.
        "error_runtime_test.go",
        "error_test.go",
        "field_summary_test.go",
        "field_values_callback_test.go",
        "field_values_limit_test.go",
        "field_values_performance_test.go",
        "field_values_test.go",
        "fields_empty_test.go",
        "fields_test.go",
        "gpu_group_test.go",
        "group_lifecycle_test.go",
        "health_test.go",
